rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Admin = de uid's in het veld `users` (array) van het badge-document met id `moderator` (de moderator-badge IS de admin-badge).
    // Een document met id `admin` werkt ook, maar is niet nodig.
    function hasBadge(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/badges/$(id))
        && request.auth.uid in get(/databases/$(database)/documents/badges/$(id)).data.get('users', []);
    }
    function isAdmin() { return hasBadge('moderator') || hasBadge('admin'); }
    function isMod() { return isAdmin(); }

    // Een DM-chat mag alleen als jullie bevestigde vrienden zijn.
    function friendship(id) {
      return get(/databases/$(database)/documents/friendships/$(id));
    }
    function isFriendChat(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(chatId))
        && friendship(chatId).data.status == 'accepted'
        && request.auth.uid in friendship(chatId).data.users;
    }

    // ---------- gebruikersnamen (uniek, publiek opzoekbaar per naam) ----------
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{2,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // je mag je eigen oude naam vrijgeven bij het wijzigen van je gebruikersnaam
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- profielen ----------
    match /users/{uid} {
      // gebruikersnaam wijzigen: hooguit 1x per 7 dagen, en de nieuwe naam moet van jou zijn
      function nameOk() {
        let d = request.resource.data;
        return d.username == resource.data.username
          ? (d.usernameLower == resource.data.usernameLower
              && d.get('usernameChangedAt', null) == resource.data.get('usernameChangedAt', null))
          : (d.username is string
              && d.username.size() >= 2 && d.username.size() <= 20
              && d.username.matches('^[A-Za-z0-9_.]+$')
              && d.usernameLower == d.username.lower()
              && d.usernameChangedAt == request.time
              && request.time > resource.data.get('usernameChangedAt', timestamp.value(0)) + duration.value(7, 'd')
              && getAfter(/databases/$(database)/documents/usernames/$(d.usernameLower)).data.uid == uid);
      }

      // TIER (Infinitum / Infinitum+ / Infinitum Prime):
      // het veld `tier` (type: string) staat op users/{uid} en is "free", "plus" of "prime".
      // Nieuwe gebruikers krijgen automatisch tier = "free". Jij verandert het in de Firebase Console
      // (Firestore Database → users → document van de persoon → veld tier → waarde aanpassen).
      // Gebruikers kunnen het niet zelf verhogen of wijzigen; moderators/admins alleen via een besluit (zie hieronder).
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'status', 'tier', 'createdAt'])
        && request.resource.data.get('tier', 'free') == 'free'      // nieuwe gebruikers starten altijd als gewoon Infinitum
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 40
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      // status, bio, profielfoto, banner en links mogen door jezelf aangepast worden
      allow update: if isSelf(uid)
        && changed(['status', 'bio', 'avatar', 'banner', 'links', 'username', 'usernameLower', 'usernameChangedAt'])
        && nameOk()
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 40
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 200
        && request.resource.data.get('avatar', '') is string
        && request.resource.data.get('avatar', '').size() <= 40000
        && request.resource.data.get('banner', '') is string
        && request.resource.data.get('banner', '').size() <= 150000
        && request.resource.data.get('links', []) is list
        && request.resource.data.get('links', []).size() <= 6
        && request.resource.data.get('tier', null) == resource.data.get('tier', null);   // tier mag je niet zelf wijzigen
      // Een moderator mag het tier van iemand anders ALLEEN zetten als er een goedgekeurde aanvraag voor precies dat tier is
      // (de goedkeuring en deze wijziging gebeuren samen in één batch).
      allow update: if isMod()
        && uid != request.auth.uid
        && changed(['tier'])
        && request.resource.data.tier in ['plus', 'prime']
        && get(/databases/$(database)/documents/subscriptions/$(uid)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.tier == request.resource.data.tier
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.decidedBy == request.auth.uid;
      // Een admin mag elk tier zetten (ook 'free' = abonnement stopzetten, en bij zichzelf), altijd samen met een vastgelegd
      // besluit in subscriptions/{uid} (zo kan de gebruiker zien wat er is veranderd en waarom).
      allow update: if isAdmin()
        && changed(['tier'])
        && request.resource.data.tier in ['free', 'plus', 'prime']
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.tier == request.resource.data.tier
        && getAfter(/databases/$(database)/documents/subscriptions/$(uid)).data.decidedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------- abonnementsaanvragen + besluiten (id = uid van de gebruiker) ----------
    match /subscriptions/{uid} {
      function validSubRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['username', 'tier', 'status', 'requestedAt'])
          && d.username is string && d.username.size() <= 20
          && d.tier in ['plus', 'prime']
          && d.status == 'pending'
          && d.requestedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.get('tier', 'free') != d.tier;
      }
      function validNote(d) {
        return d.get('note', '') is string && d.get('note', '').size() <= 200;
      }
      // een admin zet het abonnement van iemand direct op free / plus / prime, met een optioneel bericht
      function adminChange() {
        let d = request.resource.data;
        return isAdmin()
          && d.keys().hasOnly(['username', 'tier', 'status', 'decidedBy', 'decidedAt', 'note'])
          && d.username is string && d.username.size() <= 20
          && d.tier in ['free', 'plus', 'prime']
          && d.status == 'approved'
          && d.decidedBy == request.auth.uid
          && d.decidedAt == request.time
          && validNote(d);
      }

      // je ziet alleen je eigen aanvraag; moderators en admins zien alle aanvragen
      allow read: if isSelf(uid) || isMod();
      allow create: if (isSelf(uid) && validSubRequest()) || adminChange();
      allow update: if (isSelf(uid) && validSubRequest())
        || (isMod()
            && (uid != request.auth.uid || isAdmin())      // alleen een admin mag zijn eigen aanvraag goedkeuren
            && resource.data.status == 'pending'
            && changed(['status', 'decidedBy', 'decidedAt', 'note'])
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.decidedAt == request.time
            && validNote(request.resource.data))
        || adminChange();
      // aanvraag annuleren of opruimen
      allow delete: if isSelf(uid);
    }

    // ---------- functies per abonnement (de tabel; alleen admins mogen hem aanpassen) ----------
    match /features/{featureId} {
      function okCell(v) { return v is bool || (v is string && v.size() <= 30); }
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'free', 'plus', 'prime', 'order'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && okCell(request.resource.data.free)
        && okCell(request.resource.data.plus)
        && okCell(request.resource.data.prime)
        && request.resource.data.order is number;
      allow delete: if isAdmin();
    }

    // ---------- jouw instellingen (thema, meldingen, privacy...) — alleen jijzelf ----------
    match /settings/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['theme', 'bg', 'profileClick', 'privacy', 'notif'])
        && request.resource.data.theme in ['dark', 'light', 'system']
        && request.resource.data.bg is string && request.resource.data.bg.size() <= 20
        && request.resource.data.profileClick is bool
        && request.resource.data.privacy is map
        && request.resource.data.privacy.keys().hasOnly(['readReceipts'])
        && request.resource.data.privacy.readReceipts is bool
        && request.resource.data.notif is map
        && request.resource.data.notif.keys().hasOnly(['desktop', 'sound', 'dm', 'server', 'requests', 'preview'])
        && request.resource.data.notif.desktop is bool
        && request.resource.data.notif.sound is bool
        && request.resource.data.notif.dm is bool
        && request.resource.data.notif.server is bool
        && request.resource.data.notif.requests is bool
        && request.resource.data.notif.preview is bool;
      allow delete: if false;
    }

    // ---------- online / inactief / offline ----------
    function validPresence() {
      return request.resource.data.keys().hasOnly(['state', 'lastSeen'])
        && request.resource.data.state in ['online', 'idle', 'dnd', 'offline']
        && request.resource.data.lastSeen == request.time;
    }

    // Per uid op te halen (niet als lijst). Alleen jezelf mag schrijven, en maximaal 1x per 15 seconden.
    match /presence/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isSelf(uid) && validPresence();
      allow update: if isSelf(uid) && validPresence()
        && request.time > resource.data.lastSeen + duration.value(15, 's');
      allow delete: if false;
    }

    // Je eigen handmatige status (until = 0 betekent voor altijd). Alleen jijzelf.
    match /presenceSettings/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['mode', 'until'])
        && request.resource.data.mode in ['auto', 'idle', 'dnd', 'invisible']
        && request.resource.data.until is number
        && request.resource.data.until >= 0;
      allow delete: if false;
    }

    // ---------- vriendschappen + verzoeken (id = uidA_uidB) ----------
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'names', 'createdAt'])
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && pairId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // alleen de ontvanger mag accepteren
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.requester != request.auth.uid
        && resource.data.status == 'pending'
        && changed(['status'])
        && request.resource.data.status == 'accepted';

      // weigeren, annuleren of ontvrienden
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- badges (definities + wie ze heeft; alleen te wijzigen via de Firebase Console) ----------
    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- app-instellingen (alleen te wijzigen via de Firebase Console) ----------
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    function validTyping() {
      return request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    function validRead() {
      return request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // ---------- DM's ----------
    match /chats/{chatId} {
      allow read: if isFriendChat(chatId);
      allow write: if isFriendChat(chatId)
        && request.resource.data.keys().hasOnly(['lastText', 'lastUid', 'lastAt'])
        && request.resource.data.lastUid == request.auth.uid
        && request.resource.data.lastText is string
        && request.resource.data.lastText.size() <= 80
        && request.resource.data.lastAt == request.time;

      // typ-indicator: max. 1 update per 2 seconden, alleen jezelf
      match /typing/{uid} {
        allow read: if isFriendChat(chatId);
        allow create: if isFriendChat(chatId) && isSelf(uid) && validTyping();
        allow update: if isFriendChat(chatId) && isSelf(uid) && validTyping()
          && request.time > resource.data.at + duration.value(2, 's');
        allow delete: if false;
      }

      // leesbewijzen: wanneer jij het gesprek voor het laatst las (max. 1 update per 2 seconden)
      match /reads/{uid} {
        allow read: if isFriendChat(chatId);
        allow create: if isFriendChat(chatId) && isSelf(uid) && validRead();
        allow update: if isFriendChat(chatId) && isSelf(uid) && validRead()
          && request.time > resource.data.at + duration.value(2, 's');
        allow delete: if false;
      }

      match /messages/{mid} {
        allow read: if isFriendChat(chatId);
        allow create: if isFriendChat(chatId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if isFriendChat(chatId) && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ---------- servers ----------
    match /servers/{sid} {
      function serverDoc() {
        return get(/databases/$(database)/documents/servers/$(sid)).data;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // joinen met de servercode, of de server verlaten (eigenaar kan alleen verwijderen)
      allow update: if signedIn()
        && changed(['members'])
        && (
          (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
          ) || (
            request.auth.uid in resource.data.members
            && request.auth.uid != resource.data.ownerId
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /typing/{uid} {
        allow read: if signedIn() && request.auth.uid in serverDoc().members;
        allow create: if isSelf(uid) && request.auth.uid in serverDoc().members && validTyping();
        allow update: if isSelf(uid) && request.auth.uid in serverDoc().members && validTyping()
          && request.time > resource.data.at + duration.value(2, 's');
        allow delete: if false;
      }

      match /reads/{uid} {
        allow read: if signedIn() && request.auth.uid in serverDoc().members;
        allow create: if isSelf(uid) && request.auth.uid in serverDoc().members && validRead();
        allow update: if isSelf(uid) && request.auth.uid in serverDoc().members && validRead()
          && request.time > resource.data.at + duration.value(2, 's');
        allow delete: if false;
      }

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in serverDoc().members;
        allow create: if signedIn()
          && request.auth.uid in serverDoc().members
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || serverDoc().ownerId == request.auth.uid);
        allow update: if false;
      }
    }
  }
}
